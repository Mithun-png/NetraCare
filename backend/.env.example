# NetraCare Backend Environment Variables
APP_NAME=NetraCare AI Front Desk
DATABASE_URL=sqlite:///./netracare.db
CLINIC_TIMEZONE=Asia/Kolkata
# Set CLINIC_NOW for testing or leave empty for real clock
# CLINIC_NOW=2026-11-02 10:00:00
SECRET_KEY=netracare-secret-key-demo-2026

# Google Gemini API Key (Iterations 2-6)
# GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone API Key (Iteration 3)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=netracare-docs

