# NetraCare Backend Environment Variables
APP_NAME=NetraCare AI Front Desk
DATABASE_URL=sqlite:///./netracare.db
CLINIC_TIMEZONE=Asia/Kolkata

# Set CLINIC_NOW for deterministic evaluation or leave empty for real wall clock
# CLINIC_NOW=2026-11-02 10:00:00

SECRET_KEY=netracare-secret-key-demo-2026

# Google Gemini API Key (optional - offline deterministic fallback active by default)
# GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone API Key (optional - local ChromaDB active by default)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=netracare-docs

# Observability & Evals (optional)
# OPIK_API_KEY=your_opik_api_key_here
# LANGCHAIN_API_KEY=your_langsmith_api_key_here

