# NetraCare AI Front Desk Environment Configuration Example
# Copy this file to .env and provide your actual API keys

APP_NAME="NetraCare AI Front Desk"
DATABASE_URL="sqlite:///./netracare.db"
CLINIC_TIMEZONE="Asia/Kolkata"

# Injectable clock for deterministic testing (leave blank for real wall-clock time)
# CLINIC_NOW="2026-11-02 10:00:00"

SECRET_KEY="netracare-secret-key-demo-2026"

# LLM Providers (Google Gemini or OpenAI / Anthropic)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Vector Database for RAG (Iteration 3+)
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="netracare-docs"
